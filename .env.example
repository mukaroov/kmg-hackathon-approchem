# Скопируйте в .env и впишите ключ. Файл .env в git не попадает.
# Поставщик модели:
#   agent — без API: запросы кладутся в work/agent-queue/, отвечает агент (Codex, Claude Code) по README в этой папке
#   cli   — без API: конвейер сам вызывает CLI агента (LLM_CLI=claude или codex; CLI должен быть авторизован)
#   mistral | openai-compatible — HTTP API с ключом; stub — заглушка без модели, проверка каркаса
LLM_PROVIDER=agent
LLM_CLI=claude
LLM_CLI_MODEL=
LLM_CLI_PATH=
AGENT_TIMEOUT_MIN=240
MISTRAL_API_KEY=
LLM_MODEL=mistral-medium-2604
LLM_VISION_MODEL=mistral-medium-2604
OCR_MODEL=mistral-ocr-latest

# Любой другой поставщик с API, совместимым с OpenAI Chat Completions:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://example.com/v1
# LLM_API_KEY=
# LLM_MODEL=...

# Бесплатный план Mistral: 1 запрос в секунду
LLM_RPS=1
LLM_CONCURRENCY=2
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=12000
# json_schema — строгая схема ответа; json_object — схема в промпте (если поставщик не принимает строгую)
LLM_SCHEMA_MODE=json_schema
# резервные модели через запятую (при 503 или 429 запрос уходит на следующую)
LLM_FALLBACK_MODELS=
# полный текст главы в запросе плана, только если глава короче (знаков)
OUTLINE_TEXT_LIMIT=40000
LLM_CACHE=1
REPAIR_ROUNDS=2
VERIFY=1
DESCRIBE_FIGURES=1

# Цены для logs/metrics.csv: долларов за 1 млн токенов и за страницу OCR (на бесплатном плане — 0)
LLM_PRICE_IN=0
LLM_PRICE_OUT=0
OCR_PRICE_PAGE=0

# Сервер API
HOST=127.0.0.1
PORT=8787
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
MAX_UPLOAD_MB=60

# Видеодвижок (video/): Python с numpy, matplotlib, pydantic 2 и ffmpeg
PYTHON_PATH=python
FFMPEG_PATH=ffmpeg
