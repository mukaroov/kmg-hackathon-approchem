{"$defs": {"CrossplotParams": {"properties": {"template_type": {"const": "crossplot_cutoff", "default": "crossplot_cutoff", "title": "Template Type", "type": "string"}, "points": {"description": "Точки измерений из книги/датасета", "items": {"$ref": "#/$defs/CrossplotPoint"}, "minItems": 5, "title": "Points", "type": "array"}, "x_label": {"description": "Ось X, например 'Глинистость Kгл, %'", "title": "X Label", "type": "string"}, "y_label": {"description": "Ось Y, например 'Пористость Kп, %'", "title": "Y Label", "type": "string"}, "x_cutoff": {"anyOf": [{"type": "number"}, {"type": "null"}], "default": null, "description": "Граничное значение по оси X", "title": "X Cutoff"}, "y_cutoff": {"anyOf": [{"type": "number"}, {"type": "null"}], "default": null, "description": "Граничное значение по оси Y", "title": "Y Cutoff"}, "cutoff_rule_text": {"description": "Правило выделения коллектора текстом", "title": "Cutoff Rule Text", "type": "string"}}, "required": ["points", "x_label", "y_label", "cutoff_rule_text"], "title": "CrossplotParams", "type": "object"}, "CrossplotPoint": {"properties": {"x": {"title": "X", "type": "number"}, "y": {"title": "Y", "type": "number"}, "label": {"default": "", "title": "Label", "type": "string"}, "is_reservoir": {"default": false, "title": "Is Reservoir", "type": "boolean"}}, "required": ["x", "y"], "title": "CrossplotPoint", "type": "object"}, "FormulaPlotParams": {"properties": {"template_type": {"const": "formula_dynamic_plot", "default": "formula_dynamic_plot", "title": "Template Type", "type": "string"}, "formula_expr": {"description": "Математическая формула Python от переменной 'x' и dynamic_var, напр. 'rho * 9.81 * x / 1e6'", "title": "Formula Expr", "type": "string"}, "x_min": {"title": "X Min", "type": "number"}, "x_max": {"title": "X Max", "type": "number"}, "x_label": {"title": "X Label", "type": "string"}, "y_label": {"title": "Y Label", "type": "string"}, "plot_title": {"title": "Plot Title", "type": "string"}, "dynamic_var_name": {"description": "Имя изменяемого во времени параметра, напр. 'rho'", "title": "Dynamic Var Name", "type": "string"}, "dynamic_var_start": {"title": "Dynamic Var Start", "type": "number"}, "dynamic_var_end": {"title": "Dynamic Var End", "type": "number"}, "dynamic_var_unit": {"default": "", "title": "Dynamic Var Unit", "type": "string"}, "constants": {"additionalProperties": {"type": "number"}, "description": "Константы из книги, входящие в формулу", "title": "Constants", "type": "object"}}, "required": ["formula_expr", "x_min", "x_max", "x_label", "y_label", "plot_title", "dynamic_var_name", "dynamic_var_start", "dynamic_var_end"], "title": "FormulaPlotParams", "type": "object"}, "FrameClass": {"enum": ["A", "B", "C", "D"], "title": "FrameClass", "type": "string"}, "GeologicalEvolutionParams": {"properties": {"template_type": {"const": "geological_evolution", "default": "geological_evolution", "title": "Template Type", "type": "string"}, "stages": {"description": "Последовательные этапы от древних к молодым", "items": {"$ref": "#/$defs/GeologicalStage"}, "minItems": 2, "title": "Stages", "type": "array"}, "true_horizontal_m": {"description": "Реальная протяжённость разреза, м", "exclusiveMinimum": 0, "title": "True Horizontal M", "type": "number"}, "true_vertical_m": {"description": "Реальная мощность толщи, м", "exclusiveMinimum": 0, "title": "True Vertical M", "type": "number"}, "show_true_scale_at_end": {"default": true, "description": "Переключить на истинный масштаб 1:1 в финале (по ТЗ)", "title": "Show True Scale At End", "type": "boolean"}}, "required": ["stages", "true_horizontal_m", "true_vertical_m"], "title": "GeologicalEvolutionParams", "type": "object"}, "GeologicalStage": {"properties": {"stage_name": {"description": "Название этапа геологического времени", "title": "Stage Name", "type": "string"}, "x_coords": {"description": "Координаты профиля по простиранию, м", "items": {"type": "number"}, "minItems": 3, "title": "X Coords", "type": "array"}, "top_profile_m": {"description": "Кровля слоя на этом этапе, м", "items": {"type": "number"}, "minItems": 3, "title": "Top Profile M", "type": "array"}, "base_profile_m": {"description": "Подошва слоя на этом этапе, м", "items": {"type": "number"}, "minItems": 3, "title": "Base Profile M", "type": "array"}, "lithology": {"enum": ["clay", "sand_oil", "sand_water", "sand_gas", "limestone", "reef", "dolomite", "salt", "anhydrite", "dense"], "title": "Lithology", "type": "string"}}, "required": ["stage_name", "x_coords", "top_profile_m", "base_profile_m", "lithology"], "title": "GeologicalStage", "type": "object"}, "PressureWaveParams": {"properties": {"template_type": {"const": "pressure_wave_2d", "default": "pressure_wave_2d", "title": "Template Type", "type": "string"}, "p_init_mpa": {"description": "Начальное пластовое давление P0, МПа", "exclusiveMinimum": 0, "title": "P Init Mpa", "type": "number"}, "p_well_mpa": {"anyOf": [{"minimum": 0, "type": "number"}, {"type": "null"}], "default": null, "description": "Забойное давление на скважине Pc, МПа (режим well_mode='pressure')", "title": "P Well Mpa"}, "kappa_m2_s": {"description": "Коэффициент пьезопроводности, м^2/с", "exclusiveMinimum": 0, "title": "Kappa M2 S", "type": "number"}, "r_max_m": {"default": 100.0, "description": "Радиус рассматриваемой зоны пласта, м", "exclusiveMinimum": 1.0, "title": "R Max M", "type": "number"}, "r_well_m": {"default": 0.1, "description": "Радиус скважины, м", "exclusiveMinimum": 0.01, "title": "R Well M", "type": "number"}, "sim_time_sec": {"default": 3600.0, "description": "Модельное физическое время процесса, сек", "exclusiveMinimum": 1.0, "title": "Sim Time Sec", "type": "number"}, "well_mode": {"default": "pressure", "description": "'pressure' — постоянное забойное давление (численное решение); 'rate' — постоянный дебит: точная формула p = P0 − A·[−Ei(−r²/(4κt))] (основная формула упругого режима)", "enum": ["pressure", "rate"], "title": "Well Mode", "type": "string"}, "dra