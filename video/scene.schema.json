om M", "type": "number"}, "lithology": {"enum": ["clay", "sand_oil", "sand_water", "sand_gas", "limestone", "reef", "dolomite", "salt", "anhydrite", "dense"], "title": "Lithology", "type": "string"}, "label": {"title": "Label", "type": "string"}, "gk_value": {"description": "Показание гамма-каротажа (мкР/ч или API)", "title": "Gk Value", "type": "number"}, "rt_value": {"description": "Удельное электрическое сопротивление (Ом·м)", "title": "Rt Value", "type": "number"}}, "required": ["top_m", "bottom_m", "lithology", "label", "gk_value", "rt_value"], "title": "WellLayer", "type": "object"}, "WellLogParams": {"properties": {"template_type": {"const": "well_log_sync", "default": "well_log_sync", "title": "Template Type", "type": "string"}, "layers": {"description": "Список пластов сверху вниз", "items": {"$ref": "#/$defs/WellLayer"}, "minItems": 2, "title": "Layers", "type": "array"}, "gk_label": {"default": "ГК (мкР/ч)", "description": "Подпись кривой радиоактивности", "title": "Gk Label", "type": "string"}, "rt_label": {"default": "УЭС (Ом·м)", "description": "Подпись кривой сопротивления", "title": "Rt Label", "type": "string"}}, "required": ["layers"], "title": "WellLogParams", "type": "object"}}, "description": "Единая спецификация сцены, которую заполняет LLM-агент.", "properties": {"node_id": {"description": "Устойчивый ID узла учебного слоя", "title": "Node Id", "type": "string"}, "render_mode": {"$ref": "#/$defs/RenderMode", "default": "mp4"}, "video_format": {"$ref": "#/$defs/VideoFormat", "default": "16:9"}, "fps": {"default": 24, "maximum": 60, "minimum": 10, "title": "Fps", "type": "integer"}, "frame_class": {"$ref": "#/$defs/FrameClass", "description": "Только 'A' (данные) или 'B' (процесс)"}, "origin_label": {"default": "симуляция", "enum": ["симуляция", "реальные данные", "схема"], "title": "Origin Label", "type": "string"}, "is_true_scale": {"default": false, "title": "Is True Scale", "type": "boolean"}, "exaggeration_note": {"description": "Что именно